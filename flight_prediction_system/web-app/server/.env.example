# Server Configuration
PORT=3003

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=flight_prediction

# Email Service Configuration (Gmail SMTP)
# Follow these steps to set up Gmail SMTP:
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification"
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an App Password for "Mail"
# 5. Copy the 16-character password and paste it below

EMAIL_USER=your.email@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=Flight Price Alert System

# Machine Learning API Configuration
ML_API_URL=http://localhost:5000

# Web Application URL (for email links)
WEB_APP_URL=http://localhost:3000
